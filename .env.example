# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: used ONLY by /api/cron/reminders and scripts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com) — transactional email for reminders
RESEND_API_KEY=
# Where reminder and digest emails are sent
REMINDER_TO_EMAIL=you@example.com
# Optional: verified sender. Defaults to onboarding@resend.dev (works only for your own inbox).
REMINDER_FROM_EMAIL=

# Random secret; Vercel sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Public URL of the deployed app, used in email deep links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
